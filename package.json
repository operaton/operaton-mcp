{
  "name": "@operaton/mcp",
  "version": "1.3.1-SNAPSHOT",
  "description": "MCP server exposing the full Operaton BPMN/DMN REST API to AI assistants",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "license": "Apache-2.0",
  "homepage": "https://github.com/operaton/operaton-mcp#readme",
  "bugs": {
    "url": "https://github.com/operaton/operaton-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/operaton/operaton-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "operaton",
    "bpmn",
    "dmn",
    "workflow",
    "workflow-automation",
    "camunda",
    "ai",
    "llm",
    "typescript"
  ],
  "bin": {
    "operaton-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "npm run generate && tsc && tsc-alias",
    "build": "npm run generate && tsc && tsc-alias",
    "generate": "node --import tsx/esm scripts/generate.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:smoke": "vitest run test/smoke",
    "test:integration": "vitest run test/integration",
    "typecheck": "tsc --noEmit",
    "check:license": "node --import tsx/esm scripts/check-license.ts",
    "add:license": "node --import tsx/esm scripts/add-license.ts",
    "check:commits": "commitlint --config commitlint.config.ts --from HEAD~1 --to HEAD"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "msw": "^3.0.7",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
